# Salin ke .env.local untuk development, dan isi nilai yang sama di
# Vercel → Project → Settings → Environment Variables untuk production.

# ── Supabase (Project Settings → API) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Situs ────────────────────────────────────────────────────────────────
# Domain final, tanpa garis miring di akhir. Dipakai untuk canonical URL,
# sitemap.xml, robots.txt, dan Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Bot artikel harian (app/api/agent/articles) ───────────────────────────
# Provider LLM dengan format OpenAI-compatible /chat/completions.
# Contoh OpenRouter. Pilih id model di https://openrouter.ai/models (filter "Free";
# model gratis berakhiran ":free"), mis. LLM_MODEL=vendor/nama-model:free
LLM_BASE_URL=https://openrouter.ai/api/v1
# Contoh hemat: z-ai/glm-5.3-flash ($0,048 input / $0,20 output per 1 juta token)
LLM_API_KEY=
LLM_MODEL=
# Opsional (OpenRouter): low | medium | high. "low" = reasoning minimal, lebih murah dan cepat.
LLM_REASONING_EFFORT=

# Foto sampul asli otomatis dari Unsplash (opsional, gratis).
# Daftar app di https://unsplash.com/developers lalu salin Access Key.
# Kosong = artikel memakai sampul cadangan bergaya foto.
UNSPLASH_ACCESS_KEY=

# Draf Rencana Konten dibuat N jam sebelum jadwal tayang (bot jalan sekali sehari,
# jadi 48 = draf selalu siap 24–48 jam sebelum tayang). Opsional.
PLAN_LEAD_HOURS=48

# Garam rahasia untuk hash pengunjung di penghitung trafik. Isi string acak panjang.
# Kosong = memakai CRON_SECRET. Mengganti nilainya hanya mengacak ulang pengunjung unik hari itu.
TRAFFIC_SALT=

# Vercel Cron mengirim "Authorization: Bearer $CRON_SECRET" otomatis.
# Isi string acak panjang (contoh: openssl rand -hex 32).
CRON_SECRET=
# Untuk memicu bot manual / dari scheduler lain via header x-agent-secret.
AGENT_SECRET=

# ── Nanti (biarkan kosong sampai dipakai) ────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
